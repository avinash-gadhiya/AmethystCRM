  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "setup:https": "node scripts/setup-local-https.mjs --trust",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:https": "vite preview --mode https",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "prettier": {
    "bracketSpacing": true,
    "printWidth": 140,
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2,
    "useTabs": false
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "10.4.5",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.1",
    "tailwindcss": "^3.4.17"
  }
